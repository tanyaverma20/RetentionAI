# Root .env — consumed by docker-compose for variable interpolation across
# all four services. Copy to `.env` and fill in real values before running
# `docker-compose up`. Individual services also have their own .env.example
# (server/.env.example, ai-service/.env.example, client/.env.example) for
# running outside Docker.

# --- Secrets (required — compose will refuse to start without these) ---
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-different-random-characters
AI_SERVICE_TOKEN=replace-with-a-service-token
GROQ_API_KEY=replace-with-a-groq-api-key

# --- Optional overrides (sensible defaults if omitted) ---
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost
GROQ_MODEL_NAME=llama-3.1-8b-instant
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LOG_LEVEL=info

# Baked into the client build — the browser-facing API URL.
VITE_API_BASE_URL=http://localhost:5000/api/v1
