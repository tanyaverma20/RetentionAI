AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_TOKEN=replace-with-a-service-token
# When true (default), forces HF_HUB_OFFLINE/TRANSFORMERS_OFFLINE so already-
# cached NLP/embedding models load from local disk only — no network call on
# every startup. Set to false only for a genuine first-time run with no local
# model cache yet (so the models can be downloaded once).
AI_MODELS_OFFLINE=true
MODEL_ARTIFACT_PATH=../models/active
MODEL_METADATA_PATH=../models/active
# Optional: path to the IBM HR Analytics Employee Attrition & Performance CSV.
# Drop the file in ../datasets/raw/ (see datasets/README.md) and point this at
# it, e.g. ../datasets/raw/WA_Fn-UseC_-HR-Employee-Attrition.csv — when set and
# the file exists, /train uses it instead of MongoDB/synthetic data.
IBM_DATASET_CSV_PATH=
ACTIVE_MODEL_VERSION=unconfigured
CHROMA_PERSIST_DIRECTORY=./chroma_data
GROQ_API_KEY=replace-with-a-groq-api-key
GROQ_MODEL_NAME=llama-3.1-8b-instant
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
NLP_MODEL_NAME=distilbert-base-uncased
MAX_RETRIEVED_CHUNKS=5
AI_REQUEST_TIMEOUT_MS=10000
LOG_LEVEL=info
