# Production environment template for the FastAPI AI Service.
# Copy to `.env` on the production host (never commit the real file).
# Validated at startup by app/config.py's validate_startup_config() — a
# missing AI_SERVICE_TOKEN, or a missing GROQ_API_KEY while
# AI_SERVICE_ENV=production, aborts startup with a clear error instead of
# booting into a broken state.

AI_SERVICE_ENV=production
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_TOKEN=

# Keep true in production — the Docker image bakes in the spaCy model and
# the sentence-transformers/transformers models are cached on first run, so
# every subsequent startup should never need network access to load them.
AI_MODELS_OFFLINE=true

# Must match the Node server's MONGODB_URI/MONGODB_DB_NAME exactly — both
# services read and write the same database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=retentionai

MODEL_ARTIFACT_PATH=/app/models/active
MODEL_METADATA_PATH=/app/models/active
ACTIVE_MODEL_VERSION=unconfigured

CHROMA_PERSIST_DIRECTORY=/app/chroma_db

GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
NLP_MODEL_NAME=distilbert-base-uncased
MAX_RETRIEVED_CHUNKS=5
AI_REQUEST_TIMEOUT_MS=10000

LOG_LEVEL=info
LOG_DIR=/var/log/retentionai
