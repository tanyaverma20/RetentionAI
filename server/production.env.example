# Production environment template for the Express API.
# Copy to `.env` on the production host (never commit the real file).
# Every value below is validated at startup — see src/config/env.js.
# Placeholder secrets are REJECTED when NODE_ENV=production (see the
# production-only checks in env.js): generate real ones, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=production
PORT=5000

# Managed MongoDB (Atlas or equivalent) — not the local dev instance.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=retentionai

# Generate distinct 32+ char secrets for each — never reuse across environments.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated, exact scheme+host, no wildcard.
CORS_ORIGINS=https://app.retentionai.example.com

BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=30

AI_SERVICE_URL=https://ai.retentionai.example.com
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=10000

LOG_LEVEL=info
LOG_DIR=/var/log/retentionai

# Upstash Redis (REST API — https://<name>.upstash.io + token, NOT a
# redis:// TCP URL). Required in production: without it, job state (batch
# explain/decision jobs) and the AI concurrency lock live only in this
# process's memory and are lost on every restart/redeploy — exactly the
# reliability gap this variable exists to close. Set both or neither
# (env.js refuses to boot on a half-set pair).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
