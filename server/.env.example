NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net
MONGODB_DB_NAME=retentionai
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-different-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:5173
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=30
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-a-service-token
AI_SERVICE_TIMEOUT_MS=10000
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/csv
LOG_LEVEL=info
# Upstash Redis (REST API — https://<name>.upstash.io style URL + token, NOT
# a redis:// TCP URL). Backs persistent job state (batch explain/decision
# jobs) and the distributed AI concurrency lock — see utils/redisClient.js.
# Optional: both unset is a valid local-dev mode (falls back to in-process
# memory, logged loudly at startup). Setting only one of the two refuses to
# boot (see config/env.js) — set both or neither.
UPSTASH_REDIS_REST_URL=https://<your-upstash-url>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>
