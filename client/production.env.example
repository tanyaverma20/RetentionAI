# Production environment template for the React client.
# Vite bakes these in at BUILD time (not read at runtime) — set them before
# running `npm run build` or pass as Docker build args (see client/Dockerfile).

VITE_APP_NAME=RetentionAI
VITE_API_BASE_URL=https://api.retentionai.example.com/api/v1
VITE_ENVIRONMENT=production
